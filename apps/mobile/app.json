{
  "expo": {
    "name": "Landit",
    "slug": "saynow",
    "version": "1.6.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "landit",
      "com.saynow.app",
      "com.googleusercontent.apps.1062331189445-7tb3d2u3fkmqn2o1n53sqfhi7ljopqn1"
    ],
    "userInterfaceStyle": "automatic",
    "locales": {
      "ko": "./locales/ko.json",
      "ja": "./locales/ja.json"
    },
    "backgroundColor": "#e07a3a",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/97f2d216-f1c0-41d1-b912-fd31c5526f86",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "ios": {
      "buildNumber": "27",
      "bundleIdentifier": "com.saynow.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "음성 인식(말하기) 기능에 마이크를 사용합니다.",
        "ITSAppUsesNonExemptEncryption": false,
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork"
          }
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": true,
        "NSPrivacyTrackingDomains": ["ep1.facebook.com"],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": true,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising"
            ]
          }
        ]
      }
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#e28348",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saynow.app",
      "versionCode": 42,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "com.saynow.app"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "owner": "oesnuj",
    "extra": {
      "eas": {
        "projectId": "97f2d216-f1c0-41d1-b912-fd31c5526f86"
      }
    },
    "plugins": [
      "./plugins/withGradleJvmArgs.js",
      "./plugins/withAndroidxWorkAlignment.js",
      "./plugins/withAlarmLampDrawable.js",
      "expo-router",
      "expo-apple-authentication",
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "09462cccdbd1a0723c5f87929a94a528",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "handleKakaoOpenUrl": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e07a3a",
          "image": "./assets/images/splash-wordmark.png",
          "imageWidth": 156
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# 카카오 SDK — https://developers.kakao.com/docs/ko/android/getting-started (프로가드 규칙)\n-keep class com.kakao.sdk.**.model.* { <fields>; }\n\n# https://github.com/square/okhttp/pull/6792\n-dontwarn org.bouncycastle.jsse.**\n-dontwarn org.conscrypt.*\n-dontwarn org.openjsse.**\n\n# refrofit2 (with r8 full mode)\n-if interface * { @retrofit2.http.* <methods>; }\n-keep,allowobfuscation interface <1>\n-keep,allowobfuscation,allowshrinking class kotlin.coroutines.Continuation\n-if interface * { @retrofit2.http.* public *** *(...); }\n-keep,allowoptimization,allowshrinking,allowobfuscation class <3>\n-keep,allowobfuscation,allowshrinking class retrofit2.Response"
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1311169574549165",
          "clientToken": "b8d5f9f03d654d4f8577d9c767ee8cca",
          "displayName": "Landit",
          "isAutoInitEnabled": true,
          "autoLogAppEventsEnabled": true,
          "advertiserIDCollectionEnabled": true,
          "iosUserTrackingPermission": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "광고 성과를 측정하고 서비스를 개선하기 위해 기기의 활동 정보를 사용해요."
        }
      ],
      "expo-notifications",
      [
        "./modules/alarm-scheduler/app.plugin.js",
        {
          "alarmKitUsageDescription": "고른 시각에 오늘의 시나리오를 잊지 않게 알람으로 알려드려요."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "StreakSmall",
              "label": "@string/landit_widget_label",
              "description": "@string/landit_widget_description",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/preview-small.webp",
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "StreakMedium",
              "label": "@string/landit_widget_label",
              "description": "@string/landit_widget_description",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/preview-medium.webp",
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "StreakLarge",
              "label": "@string/landit_widget_label",
              "description": "@string/landit_widget_description_large",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "previewImage": "./assets/widgets/preview-large.webp",
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withWidgetLocales.js",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.saynow.app",
          "widgets": [
            {
              "name": "StreakWidget",
              "displayName": "랜딧",
              "description": "래디와 함께 매일 대화 스트릭을 지켜요",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ],
              "contentMarginsDisabled": true
            }
          ]
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "saynow",
          "experimental_android": {
            "enableAndroidGradlePlugin": true,
            "uploadNativeSymbols": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "피드백에 첨부할 사진을 고르는 데 사진 보관함을 사용합니다.",
          "cameraPermission": false,
          "microphonePermission": "음성 인식(말하기) 기능에 마이크를 사용합니다."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false,
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["ko", "ja"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
